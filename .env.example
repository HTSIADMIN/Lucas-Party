# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables.

# Supabase project URL and publishable (anon) key. Both are public: browsers use
# them for Realtime, which carries every party. Required.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret (Supabase → Project Settings → API Keys → Secret key, or the
# legacy service_role key). Never commit it. Required on Vercel. Leave it out
# locally and accounts live in a SQLite file under DATA_DIR instead.
SUPABASE_SERVICE_ROLE_KEY=

# This username becomes admin the moment it signs up or logs in.
BOOTSTRAP_ADMIN=lucas

# Optional. The address the TV shows next to its QR code. On Vercel it defaults
# to the production domain; locally the TV shows your LAN address.
PUBLIC_URL=

# Optional. Where the local SQLite database lives (no service key set).
DATA_DIR=./data

# Optional compute guard rails.
MAX_ACTIVE_ROOMS=25
MAX_ROOMS_PER_HOST=2

# Optional. Extra origins allowed to send API writes (same host is always allowed).
ALLOWED_ORIGINS=
